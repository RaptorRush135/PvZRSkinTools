{
    "editor.formatOnSave": true,
    "editor.rulers": [
        88
    ],
    "files.exclude": {
        "**/__pycache__": true,
        ".ruff_cache": true,
        ".venv": true,
        ".vs": true
    },
    "python.analysis.typeCheckingMode": "strict",
    "python.analysis.diagnosticMode": "workspace",
    "sonarlint.disableTelemetry": true,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
}